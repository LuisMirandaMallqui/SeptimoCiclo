        <mxCell id="DIxpu45CqziUapRNBQAB-9" value="&lt;div&gt;De la visión empresarial:&lt;/div&gt;El ¿Como lo hacemos?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
