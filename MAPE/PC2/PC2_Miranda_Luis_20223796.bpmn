  <bpmn:collaboration id="Collaboration_1xwi96o">
    <bpmn:participant id="Participant_1hkvlbz" name="Concurso de Contratación de Nuevos Profesores" processRef="Process_05es85a" />
    <bpmn:textAnnotation id="TextAnnotation_1mtvktl">
      <bpmn:text>Incluye las plazas, normas, procedimientos a seguir, requisitos y documentos que se van a requerir para la contratación.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_15s0ylh">
      <bpmn:text>Subsana observaciones del consejo en el nuevo documento del regalmento</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_049e99o">
      <bpmn:text>Descarga del sistema UPP</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_136gxxz">
      <bpmn:text>Documentos del postulante:
-Currículum vitae
-Carta motivadora
-Documentos adjuntos</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0lbtn7k" associationDirection="None" sourceRef="DataObjectReference_0dkfiqd" targetRef="TextAnnotation_1mtvktl" />
