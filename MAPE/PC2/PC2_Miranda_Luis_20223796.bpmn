    <bpmn:textAnnotation id="TextAnnotation_0q1irwz">
      <bpmn:text>Se considera los tres primeros puestos</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_05o83my" associationDirection="None" sourceRef="Activity_1mnifrc" targetRef="TextAnnotation_0q1irwz" />
    <bpmn:textAnnotation id="TextAnnotation_0bl66vp">
      <bpmn:text>Puntaje en función de la vinculación y el compromiso del postulante con la UPP</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0lfo4em" associationDirection="None" sourceRef="Activity_1mnifrc" targetRef="TextAnnotation_0bl66vp" />
    <bpmn:textAnnotation id="TextAnnotation_0la42qz">
      <bpmn:text>Se solicita citar nuevamente al comité evaluador</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_188dzci" associationDirection="None" sourceRef="Flow_19yxm1l" targetRef="TextAnnotation_0la42qz" />
