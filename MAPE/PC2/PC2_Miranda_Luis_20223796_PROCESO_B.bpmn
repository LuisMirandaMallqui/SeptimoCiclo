  <bpmn:collaboration id="Collaboration_0xhux87">
    <bpmn:participant id="Participant_10mocv6" name="Premiación de los Proyectos de Investigación" processRef="Process_0nlyv2d" />
    <bpmn:textAnnotation id="TextAnnotation_0ogsaw1">
      <bpmn:text>Se detalla la evaluación a los proyectos que postulen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_18kqtig">
      <bpmn:text>Al publicar, se da por aviso a toda la comunidad universitaria de la premiación a realizar</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_08fnmxy">
      <bpmn:text>Debe incluir título de la investigación, involucrados, unidad. Además, se debe proveer de toda la  información técnica, metodológica y de presupuesto</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1hsbth7">
      <bpmn:text>Archivada de forma temporal hasta la recepción de las fichas de los demás proyectos</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1c8gmgk">
      <bpmn:text>Ordenados por su calificación obtenida</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0dnixh8" associationDirection="None" sourceRef="Activity_0o6ntsc" targetRef="TextAnnotation_18kqtig" />
    <bpmn:association id="Association_0rxjhp5" associationDirection="None" sourceRef="Activity_0ukoe7i" targetRef="TextAnnotation_08fnmxy" />
