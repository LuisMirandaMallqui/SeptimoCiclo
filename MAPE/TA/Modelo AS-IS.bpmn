    <bpmn:textAnnotation id="TextAnnotation_0mptyg4">
      <bpmn:text>Al enviar una solicitud, automáticamente se genera un expediente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_17p8c68" associationDirection="None" sourceRef="Activity_1l2o2lq" targetRef="TextAnnotation_0mptyg4" />
    <bpmn:textAnnotation id="TextAnnotation_1576fhs">
      <bpmn:text>Un escrito son documentos que presentan las partes involucradas para expresar argumentos, solicitudes, defensas o pruebas.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0tf3e62" associationDirection="None" sourceRef="Activity_0jtxj2u" targetRef="TextAnnotation_1576fhs" />
    <bpmn:textAnnotation id="TextAnnotation_136hdtq">
      <bpmn:text>Al no existir una contestación para JPRD, se realiza a través de un escrito</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_10fp0hl" associationDirection="None" sourceRef="Activity_05zkx2e" targetRef="TextAnnotation_136hdtq" />
  </bpmn:collaboration>
